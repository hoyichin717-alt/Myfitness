<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>PROGRESS LOG｜訓練追蹤</title>
<style>
  :root{
    --bg:#0a0f0c;
    --bg-panel:#101713;
    --bg-raised:#161f19;
    --line:#243027;
    --lime:#c8ff3d;
    --lime-dim:#8fb62c;
    --text:#e9f2ea;
    --text-dim:#8fa295;
    --text-faint:#5c6d63;
    --danger:#ff5d5d;
    --font-display:'Archivo Black','Arial Black',sans-serif;
    --font-body:'Inter',-apple-system,'Segoe UI',sans-serif;
    --font-mono:'JetBrains Mono','Courier New',monospace;
  }

  *{box-sizing:border-box;}
  html,body{margin:0;padding:0; min-height:100%;}
  :root{ padding-top:env(safe-area-inset-top, 0px); padding-bottom:env(safe-area-inset-bottom, 0px); }
  html{ scroll-padding-top:env(safe-area-inset-top, 0px); background:var(--bg) !important; }
  body{
    background:var(--bg) !important;
    color:var(--text);
    font-family:var(--font-body);
    -webkit-font-smoothing:antialiased;
    padding-bottom:90px;
    min-height:100vh;
  }
  #app-root{
    background:var(--bg);
    min-height:100vh;
  }

  ::selection{background:var(--lime);color:#0a0f0c;}

  /* ---------- Header / Nav ---------- */
  header{
    position:sticky; top:0; z-index:50;
    padding-top:env(safe-area-inset-top, 0px);
    background:rgba(10,15,12,0.92);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .brand-row{
    display:flex; align-items:baseline; justify-content:space-between;
    padding:16px 18px 10px;
  }
  .brand{
    font-family:var(--font-display);
    font-size:20px;
    letter-spacing:-0.02em;
    color:var(--text);
  }
  .brand span{color:var(--lime);}
  .brand-sub{
    font-family:var(--font-mono);
    font-size:11px;
    color:var(--text-faint);
  }
  nav.tabs{
    display:flex; gap:2px;
    padding:0 12px 12px;
  }
  nav.tabs button{
    flex:1;
    background:none; border:none;
    color:var(--text-dim);
    font-family:var(--font-body);
    font-weight:600;
    font-size:14px;
    padding:10px 4px;
    border-bottom:3px solid transparent;
    cursor:pointer;
    transition:color .15s ease, border-color .15s ease;
  }
  nav.tabs button.active{
    color:var(--lime);
    border-bottom-color:var(--lime);
  }

  main{max-width:640px; margin:0 auto; padding:18px 14px 30px;}
  .page{display:none;}
  .page.active{display:block; animation:fadein .25s ease;}
  @keyframes fadein{from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:translateY(0);}}

  h2.page-title{
    font-family:var(--font-display);
    font-size:22px;
    margin:4px 0 16px;
    letter-spacing:-0.01em;
  }
  h2.page-title .accent{color:var(--lime);}

  .card{
    background:var(--bg-panel);
    border:1px solid var(--line);
    border-radius:10px;
    padding:16px;
    margin-bottom:14px;
  }

  /* ---------- Body metrics page ---------- */
  .metric-grid{
    display:grid; grid-template-columns:repeat(3,1fr); gap:10px;
    margin-bottom:16px;
  }
  .metric-box{
    background:var(--bg-panel); border:1px solid var(--line); border-radius:10px;
    padding:12px 8px; text-align:center;
  }
  .metric-box .label{font-size:11px; color:var(--text-dim); margin-bottom:6px;}
  .metric-box .value{font-family:var(--font-mono); font-size:20px; font-weight:700; color:var(--lime);}
  .metric-box .unit{font-size:11px; color:var(--text-faint);}
  .metric-box .delta{font-family:var(--font-mono); font-size:11px; margin-top:4px;}
  .delta.up{color:var(--danger);}
  .delta.down{color:var(--lime);}
  .delta.flat{color:var(--text-faint);}

  .form-row{display:flex; flex-wrap:wrap; gap:10px; margin-bottom:10px;}
